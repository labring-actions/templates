apiVersion: v1
kind: Namespace
metadata:
  name: {{ .elasticsearchNamespace }}
---
# Source: logstash/templates/configmap.yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: logstash-pipeline
  namespace: {{ .elasticsearchNamespace }}
  labels:
    app: "logstash"
data:
  logstash.yml: |
    http.host: "0.0.0.0"
    xpack.monitoring.enabled: false
    pipeline.ordered: auto
    config.reload.automatic: true
    path.config: /usr/share/logstash/pipeline
  logstash.conf: |
    input {
      beats {
        port => 5044
      }
    }

    filter {
    }

    output {
      elasticsearch {
        hosts => ["https://elasticsearch-master.{{ .elasticsearchNamespace }}.svc:9200"]
        user => "elastic"
        password => "${ELASTICSEARCH_PASSWORD}"
        ssl => true
        cacert => "/usr/share/logstash/config/certs/tls.crt"
        index => "logstash-%{+YYYY.MM.dd}"
      }
      stdout { codec => rubydebug }
    }
---
# Source: logstash/templates/service.yaml
apiVersion: v1
kind: Service
metadata:
  name: logstash
  namespace: {{ .elasticsearchNamespace }}
  labels:
    app: "logstash"
spec:
  type: ClusterIP
  selector:
    app: "logstash"
  ports:
    - name: beats
      protocol: TCP
      port: 5044
      targetPort: 5044
    - name: api
      protocol: TCP
      port: 9600
      targetPort: 9600
---
# Source: logstash/templates/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: logstash
  namespace: {{ .elasticsearchNamespace }}
  labels:
    app: "logstash"
spec:
  replicas: {{ .logstashReplicas }}
  selector:
    matchLabels:
      app: "logstash"
  template:
    metadata:
      labels:
        app: "logstash"
    spec:
      containers:
        - name: logstash
          image: docker.elastic.co/logstash/logstash:8.5.1
          imagePullPolicy: IfNotPresent
          ports:
            - name: beats
              containerPort: 5044
            - name: api
              containerPort: 9600
          env:
            - name: LS_JAVA_OPTS
              value: "-Xms{{ .logstashJavaHeap }} -Xmx{{ .logstashJavaHeap }}"
            - name: ELASTICSEARCH_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: elasticsearch-master-credentials
                  key: password
          readinessProbe:
            tcpSocket:
              port: 5044
            initialDelaySeconds: 20
            periodSeconds: 10
            timeoutSeconds: 5
            successThreshold: 1
            failureThreshold: 6
          livenessProbe:
            tcpSocket:
              port: 5044
            initialDelaySeconds: 60
            periodSeconds: 20
            timeoutSeconds: 5
            successThreshold: 1
            failureThreshold: 3
          resources:
            requests:
              cpu: {{ .logstashRequestsCPU }}
              memory: {{ .logstashRequestsMemory }}
            limits:
              cpu: {{ .logstashLimitsCPU }}
              memory: {{ .logstashLimitsMemory }}
          volumeMounts:
            - name: logstash-pipeline
              mountPath: /usr/share/logstash/config/logstash.yml
              subPath: logstash.yml
              readOnly: true
            - name: logstash-pipeline
              mountPath: /usr/share/logstash/pipeline/logstash.conf
              subPath: logstash.conf
              readOnly: true
            - name: elasticsearch-ca
              mountPath: /usr/share/logstash/config/certs
              readOnly: true
      volumes:
        - name: logstash-pipeline
          configMap:
            name: logstash-pipeline
        - name: elasticsearch-ca
          secret:
            secretName: {{ .elasticsearchCASecretName }}
