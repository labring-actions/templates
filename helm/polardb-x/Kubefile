FROM scratch

ENV NAMESPACE ns-admin
ENV POLARDBX_RELEASE_NAME polardbx-operator
ENV POLARDBX_IMAGE_REPO polardbx-opensource-registry.cn-beijing.cr.aliyuncs.com/polardbx
ENV POLARDBX_IMAGE_TAG v1.7.0
ENV POLARDBX_VERSION v1.7.0
ENV POLARDBX_USE_LATEST_IMAGE false
ENV POLARDBX_CLUSTER_VERSION latest
ENV POLARDBX_GALAXYSQL_IMAGE polardbx-sql
ENV POLARDBX_GALAXYENGINE_IMAGE polardbx-engine-2.0
ENV POLARDBX_GALAXYCDC_IMAGE polardbx-cdc
ENV POLARDBX_NODE_VOLUME_DATA /data
ENV POLARDBX_NODE_VOLUME_LOG /data-log
ENV POLARDBX_NODE_VOLUME_FILESTREAM /filestream
ENV POLARDBX_CONTROLLER_REPLICAS 1
ENV POLARDBX_CONTROLLER_REQUESTS_CPU 100m
ENV POLARDBX_CONTROLLER_REQUESTS_MEMORY 50Mi
ENV POLARDBX_CONTROLLER_LIMITS_CPU 100m
ENV POLARDBX_CONTROLLER_LIMITS_MEMORY 50Mi
ENV POLARDBX_HPFS_REQUESTS_CPU 100m
ENV POLARDBX_HPFS_REQUESTS_MEMORY 50Mi
ENV POLARDBX_HPFS_LIMITS_CPU 100m
ENV POLARDBX_HPFS_LIMITS_MEMORY 50Mi
ENV POLARDBX_ALLOW_SCHEDULE_ON_MASTER true
ENV POLARDBX_ENABLE_ACK_RESOURCE_CONTROLLER true
ENV POLARDBX_ENABLE_EXPORTERS true
ENV POLARDBX_ENABLE_PRIVILEGED_CONTAINER false
ENV POLARDBX_FORCE_CGROUP false
ENV POLARDBX_USE_HOST_TIME_ZONE true
ENV POLARDBX_HPFS_PORT 6543
ENV POLARDBX_HPFS_FS_PORT 6643
ENV POLARDBX_WEBHOOK_PROTOCOL_VERSION 8.0
ENV POLARDBX_WEBHOOK_STORAGE_ENGINE galaxy
ENV POLARDBX_WEBHOOK_SERVICE_TYPE ClusterIP
ENV POLARDBX_WEBHOOK_UPGRADE_STRATEGY RollingUpgrade

COPY charts charts
COPY registry registry

CMD ["helm upgrade --install $(POLARDBX_RELEASE_NAME) charts/polardbx-operator --namespace=$(NAMESPACE) --create-namespace --set-string imageRepo=$(POLARDBX_IMAGE_REPO) --set-string imageTag=$(POLARDBX_IMAGE_TAG) --set-string version=$(POLARDBX_VERSION) --set useLatestImage=$(POLARDBX_USE_LATEST_IMAGE) --set-string clusterDefaults.version=$(POLARDBX_CLUSTER_VERSION) --set-string clusterDefaults.images.galaxysql=$(POLARDBX_GALAXYSQL_IMAGE) --set-string clusterDefaults.images.galaxyengine=$(POLARDBX_GALAXYENGINE_IMAGE) --set-string clusterDefaults.images.galaxycdc=$(POLARDBX_GALAXYCDC_IMAGE) --set-string node.volumes.data=$(POLARDBX_NODE_VOLUME_DATA) --set-string node.volumes.log=$(POLARDBX_NODE_VOLUME_LOG) --set-string node.volumes.filestream=$(POLARDBX_NODE_VOLUME_FILESTREAM) --set controllerManager.replicas=$(POLARDBX_CONTROLLER_REPLICAS) --set-string controllerManager.resources.requests.cpu=$(POLARDBX_CONTROLLER_REQUESTS_CPU) --set-string controllerManager.resources.requests.memory=$(POLARDBX_CONTROLLER_REQUESTS_MEMORY) --set-string controllerManager.resources.limits.cpu=$(POLARDBX_CONTROLLER_LIMITS_CPU) --set-string controllerManager.resources.limits.memory=$(POLARDBX_CONTROLLER_LIMITS_MEMORY) --set-string hostPathFileService.resources.requests.cpu=$(POLARDBX_HPFS_REQUESTS_CPU) --set-string hostPathFileService.resources.requests.memory=$(POLARDBX_HPFS_REQUESTS_MEMORY) --set-string hostPathFileService.resources.limits.cpu=$(POLARDBX_HPFS_LIMITS_CPU) --set-string hostPathFileService.resources.limits.memory=$(POLARDBX_HPFS_LIMITS_MEMORY) --set controllerManager.config.scheduler.allowScheduleOnMaster=$(POLARDBX_ALLOW_SCHEDULE_ON_MASTER) --set controllerManager.config.scheduler.enableAliyunAckResourceController=$(POLARDBX_ENABLE_ACK_RESOURCE_CONTROLLER) --set controllerManager.config.enableExporters=$(POLARDBX_ENABLE_EXPORTERS) --set controllerManager.config.container.privileged=$(POLARDBX_ENABLE_PRIVILEGED_CONTAINER) --set controllerManager.config.container.forceCGroup=$(POLARDBX_FORCE_CGROUP) --set controllerManager.useHostTimeZone=$(POLARDBX_USE_HOST_TIME_ZONE) --set hostPathFileService.port=$(POLARDBX_HPFS_PORT) --set hostPathFileService.fsPort=$(POLARDBX_HPFS_FS_PORT) --set-string webhook.defaults.protocolVersion=$(POLARDBX_WEBHOOK_PROTOCOL_VERSION) --set-string webhook.defaults.storageEngine=$(POLARDBX_WEBHOOK_STORAGE_ENGINE) --set-string webhook.defaults.serviceType=$(POLARDBX_WEBHOOK_SERVICE_TYPE) --set-string webhook.defaults.upgradeStrategy=$(POLARDBX_WEBHOOK_UPGRADE_STRATEGY)"]
