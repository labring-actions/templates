FROM scratch

ENV NAMESPACE ns-admin
ENV IMAGE_TAG 7.17.28
ENV ELASTICSEARCH_STORAGE 100Gi
ENV ELASTICSEARCH_STORAGE_CLASS openebs-hostpath
ENV ELASTICSEARCH_REQUESTS_CPU 1
ENV ELASTICSEARCH_LIMITS_CPU 2
ENV ELASTICSEARCH_REQUESTS_MEMORY 4Gi
ENV ELASTICSEARCH_LIMITS_MEMORY 8Gi
ENV ELASTICSEARCH_JAVA_HEAP 4g
ENV ELASTICSEARCH_TLS_SECRET_NAME elasticsearch-master-certs
ENV ELASTICSEARCH_PASSWORD please-change-this-password

COPY charts charts
COPY registry registry

CMD ["helm upgrade --install elasticsearch charts/elasticsearch --namespace=$(NAMESPACE) --create-namespace --set-string elasticsearch.image.tag=$(IMAGE_TAG) --set-string elasticsearch.storage=$(ELASTICSEARCH_STORAGE) --set-string elasticsearch.storageClass=$(ELASTICSEARCH_STORAGE_CLASS) --set-string elasticsearch.requests.cpu=$(ELASTICSEARCH_REQUESTS_CPU) --set-string elasticsearch.limits.cpu=$(ELASTICSEARCH_LIMITS_CPU) --set-string elasticsearch.requests.memory=$(ELASTICSEARCH_REQUESTS_MEMORY) --set-string elasticsearch.limits.memory=$(ELASTICSEARCH_LIMITS_MEMORY) --set-string elasticsearch.javaHeap=$(ELASTICSEARCH_JAVA_HEAP) --set-string elasticsearch.tlsSecretName=$(ELASTICSEARCH_TLS_SECRET_NAME) --set-string elasticsearch.password=$(ELASTICSEARCH_PASSWORD)"]
