FROM scratch

ENV NAMESPACE ns-admin
ENV HDFS_IMAGE_REPOSITORY crpi-wsxiy5y9ovijxdks.cn-hangzhou.personal.cr.aliyuncs.com/jockey/sealos
ENV HDFS_IMAGE_TAG hdfs-3.3.6
ENV HDFS_IMAGE_PULL_POLICY IfNotPresent
ENV HDFS_NAMENODE_REPLICAS 1
ENV HDFS_DATANODE_REPLICAS 1
ENV HDFS_DFS_REPLICATION 1
ENV HDFS_PERMISSIONS_ENABLED false
ENV HDFS_NAMENODE_STORAGE_CLASS openebs-hostpath
ENV HDFS_NAMENODE_STORAGE_SIZE 10Gi
ENV HDFS_DATANODE_STORAGE_CLASS openebs-hostpath
ENV HDFS_DATANODE_STORAGE_SIZE 20Gi
ENV HDFS_NAMENODE_REQUESTS_CPU 500m
ENV HDFS_NAMENODE_LIMITS_CPU 2
ENV HDFS_NAMENODE_REQUESTS_MEMORY 1Gi
ENV HDFS_NAMENODE_LIMITS_MEMORY 2Gi
ENV HDFS_DATANODE_REQUESTS_CPU 500m
ENV HDFS_DATANODE_LIMITS_CPU 2
ENV HDFS_DATANODE_REQUESTS_MEMORY 1Gi
ENV HDFS_DATANODE_LIMITS_MEMORY 2Gi
ENV SEALOS_CLOUD_DOMAIN 127.0.0.1.nip.io
ENV SEALOS_CERT_SECRET_NAME wildcard-cert
ENV SEALOS_INGRESS_CLASS_NAME nginx
ENV SEALOS_INGRESS_ENABLED true
ENV SEALOS_APP_ENABLED true
ENV SEALOS_HOST_PREFIX hdfs

COPY charts charts
COPY registry registry

CMD ["helm upgrade --install hdfs charts/hdfs --namespace=$(NAMESPACE) --create-namespace --set-string hdfs.image.repository=$(HDFS_IMAGE_REPOSITORY) --set-string hdfs.image.tag=$(HDFS_IMAGE_TAG) --set-string hdfs.image.pullPolicy=$(HDFS_IMAGE_PULL_POLICY) --set hdfs.nameNode.replicas=$(HDFS_NAMENODE_REPLICAS) --set hdfs.dataNode.replicas=$(HDFS_DATANODE_REPLICAS) --set hdfs.config.dfsReplication=$(HDFS_DFS_REPLICATION) --set hdfs.config.dfsPermissionsEnabled=$(HDFS_PERMISSIONS_ENABLED) --set-string hdfs.nameNode.persistence.storageClass=$(HDFS_NAMENODE_STORAGE_CLASS) --set-string hdfs.nameNode.persistence.size=$(HDFS_NAMENODE_STORAGE_SIZE) --set-string hdfs.dataNode.persistence.storageClass=$(HDFS_DATANODE_STORAGE_CLASS) --set-string hdfs.dataNode.persistence.size=$(HDFS_DATANODE_STORAGE_SIZE) --set-string hdfs.nameNode.requests.cpu=$(HDFS_NAMENODE_REQUESTS_CPU) --set-string hdfs.nameNode.limits.cpu=$(HDFS_NAMENODE_LIMITS_CPU) --set-string hdfs.nameNode.requests.memory=$(HDFS_NAMENODE_REQUESTS_MEMORY) --set-string hdfs.nameNode.limits.memory=$(HDFS_NAMENODE_LIMITS_MEMORY) --set-string hdfs.dataNode.requests.cpu=$(HDFS_DATANODE_REQUESTS_CPU) --set-string hdfs.dataNode.limits.cpu=$(HDFS_DATANODE_LIMITS_CPU) --set-string hdfs.dataNode.requests.memory=$(HDFS_DATANODE_REQUESTS_MEMORY) --set-string hdfs.dataNode.limits.memory=$(HDFS_DATANODE_LIMITS_MEMORY) --set-string sealos.cloudDomain=$(SEALOS_CLOUD_DOMAIN) --set-string sealos.certSecretName=$(SEALOS_CERT_SECRET_NAME) --set-string sealos.ingressClassName=$(SEALOS_INGRESS_CLASS_NAME) --set sealos.ingress.enabled=$(SEALOS_INGRESS_ENABLED) --set sealos.app.enabled=$(SEALOS_APP_ENABLED) --set-string sealos.hostPrefix=$(SEALOS_HOST_PREFIX)"]
