FROM scratch

ENV NAMESPACE ns-admin
ENV KIBANA_REPLICAS 1
ENV KIBANA_REQUESTS_CPU 500m
ENV KIBANA_LIMITS_CPU 1
ENV KIBANA_REQUESTS_MEMORY 1Gi
ENV KIBANA_LIMITS_MEMORY 2Gi
ENV KIBANA_TLS_SECRET_NAME kibana-certs
ENV ELASTICSEARCH_CA_SECRET_NAME elasticsearch-ca-secret
ENV SEALOS_CLOUD_DOMAIN 127.0.0.1.nip.io
ENV SEALOS_CERT_SECRET_NAME wildcard-cert

COPY charts charts
COPY registry registry

CMD ["helm upgrade --install kibana charts/kibana --namespace=$(NAMESPACE) --create-namespace --set kibana.replicas=$(KIBANA_REPLICAS) --set-string kibana.requests.cpu=$(KIBANA_REQUESTS_CPU) --set-string kibana.limits.cpu=$(KIBANA_LIMITS_CPU) --set-string kibana.requests.memory=$(KIBANA_REQUESTS_MEMORY) --set-string kibana.limits.memory=$(KIBANA_LIMITS_MEMORY) --set-string kibana.tlsSecretName=$(KIBANA_TLS_SECRET_NAME) --set-string elasticsearch.caSecretName=$(ELASTICSEARCH_CA_SECRET_NAME) --set-string sealos.cloudDomain=$(SEALOS_CLOUD_DOMAIN) --set-string sealos.certSecretName=$(SEALOS_CERT_SECRET_NAME)"]
