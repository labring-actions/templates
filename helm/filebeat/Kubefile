FROM scratch

ENV NAMESPACE ns-admin
ENV FILEBEAT_REQUESTS_CPU 100m
ENV FILEBEAT_LIMITS_CPU 300m
ENV FILEBEAT_REQUESTS_MEMORY 200Mi
ENV FILEBEAT_LIMITS_MEMORY 500Mi

COPY charts charts
COPY registry registry

CMD ["helm upgrade --install filebeat charts/filebeat --namespace=$(NAMESPACE) --create-namespace --set-string filebeat.requests.cpu=$(FILEBEAT_REQUESTS_CPU) --set-string filebeat.limits.cpu=$(FILEBEAT_LIMITS_CPU) --set-string filebeat.requests.memory=$(FILEBEAT_REQUESTS_MEMORY) --set-string filebeat.limits.memory=$(FILEBEAT_LIMITS_MEMORY)"]
