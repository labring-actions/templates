FROM scratch

ENV NAMESPACE ns-admin
ENV HADOOP_IMAGE_REPOSITORY crpi-wsxiy5y9ovijxdks.cn-hangzhou.personal.cr.aliyuncs.com/jockey/sealos
ENV HADOOP_IMAGE_TAG hadoop-3.3.6
