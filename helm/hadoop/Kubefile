ENV SEALOS_CERT_SECRET_NAME wildcard-cert
ENV SEALOS_INGRESS_CLASS_NAME nginx
ENV SEALOS_INGRESS_ENABLED true
ENV SEALOS_APP_ENABLED true
ENV SEALOS_RESOURCEMANAGER_HOST_PREFIX hadoop
ENV SEALOS_NAMENODE_HOST_PREFIX hadoop-namenode

COPY charts charts
COPY registry registry

CMD ["helm upgrade --install hadoop charts/hadoop --namespace=$(NAMESPACE) --create-namespace --set-string hadoop.image.repository=$(HADOOP_IMAGE_REPOSITORY) --set-string hadoop.image.tag=$(HADOOP_IMAGE_TAG) --set-string hadoop.image.pullPolicy=$(HADOOP_IMAGE_PULL_POLICY) --set hadoop.nameNode.replicas=$(HADOOP_NAMENODE_REPLICAS) --set hadoop.dataNode.replicas=$(HADOOP_DATANODE_REPLICAS) --set hadoop.resourceManager.replicas=$(HADOOP_RESOURCEMANAGER_REPLICAS) --set hadoop.nodeManager.replicas=$(HADOOP_NODEMANAGER_REPLICAS) --set hadoop.config.dfsReplication=$(HADOOP_DFS_REPLICATION) --set-string hadoop.nameNode.persistence.storageClass=$(HADOOP_NAMENODE_STORAGE_CLASS) --set-string hadoop.nameNode.persistence.size=$(HADOOP_NAMENODE_STORAGE_SIZE) --set-string hadoop.dataNode.persistence.storageClass=$(HADOOP_DATANODE_STORAGE_CLASS) --set-string hadoop.dataNode.persistence.size=$(HADOOP_DATANODE_STORAGE_SIZE) --set-string hadoop.resourceManager.persistence.storageClass=$(HADOOP_RM_STORAGE_CLASS) --set-string hadoop.resourceManager.persistence.size=$(HADOOP_RM_STORAGE_SIZE) --set-string hadoop.nodeManager.persistence.storageClass=$(HADOOP_NM_STORAGE_CLASS) --set-string hadoop.nodeManager.persistence.size=$(HADOOP_NM_STORAGE_SIZE) --set-string hadoop.nameNode.requests.cpu=$(HADOOP_NAMENODE_REQUESTS_CPU) --set-string hadoop.nameNode.limits.cpu=$(HADOOP_NAMENODE_LIMITS_CPU) --set-string hadoop.nameNode.requests.memory=$(HADOOP_NAMENODE_REQUESTS_MEMORY) --set-string hadoop.nameNode.limits.memory=$(HADOOP_NAMENODE_LIMITS_MEMORY) --set-string hadoop.dataNode.requests.cpu=$(HADOOP_DATANODE_REQUESTS_CPU) --set-string hadoop.dataNode.limits.cpu=$(HADOOP_DATANODE_LIMITS_CPU) --set-string hadoop.dataNode.requests.memory=$(HADOOP_DATANODE_REQUESTS_MEMORY) --set-string hadoop.dataNode.limits.memory=$(HADOOP_DATANODE_LIMITS_MEMORY) --set-string hadoop.resourceManager.requests.cpu=$(HADOOP_RM_REQUESTS_CPU) --set-string hadoop.resourceManager.limits.cpu=$(HADOOP_RM_LIMITS_CPU) --set-string hadoop.resourceManager.requests.memory=$(HADOOP_RM_REQUESTS_MEMORY) --set-string hadoop.resourceManager.limits.memory=$(HADOOP_RM_LIMITS_MEMORY) --set-string hadoop.nodeManager.requests.cpu=$(HADOOP_NM_REQUESTS_CPU) --set-string hadoop.nodeManager.limits.cpu=$(HADOOP_NM_LIMITS_CPU) --set-string hadoop.nodeManager.requests.memory=$(HADOOP_NM_REQUESTS_MEMORY) --set-string hadoop.nodeManager.limits.memory=$(HADOOP_NM_LIMITS_MEMORY) --set hadoop.config.nodeManagerMemoryMb=$(HADOOP_NODEMANAGER_MEMORY_MB) --set hadoop.config.nodeManagerVCores=$(HADOOP_NODEMANAGER_VCORES) --set hadoop.config.schedulerMinimumAllocationMb=$(HADOOP_SCHEDULER_MINIMUM_ALLOCATION_MB) --set hadoop.config.schedulerMaximumAllocationMb=$(HADOOP_SCHEDULER_MAXIMUM_ALLOCATION_MB) --set hadoop.config.logAggregationEnabled=$(HADOOP_LOG_AGGREGATION_ENABLED) --set-string sealos.cloudDomain=$(SEALOS_CLOUD_DOMAIN) --set-string sealos.certSecretName=$(SEALOS_CERT_SECRET_NAME) --set-string sealos.ingressClassName=$(SEALOS_INGRESS_CLASS_NAME) --set sealos.ingress.enabled=$(SEALOS_INGRESS_ENABLED) --set sealos.app.enabled=$(SEALOS_APP_ENABLED) --set-string sealos.resourceManager.hostPrefix=$(SEALOS_RESOURCEMANAGER_HOST_PREFIX) --set-string sealos.nameNode.hostPrefix=$(SEALOS_NAMENODE_HOST_PREFIX)"]
