FROM scratch

ENV NAMESPACE ns-admin
ENV SKYWALKING_OAP_REPLICAS 1
ENV SKYWALKING_UI_REPLICAS 1
ENV SKYWALKING_OAP_IMAGE_REPOSITORY crpi-wsxiy5y9ovijxdks.cn-hangzhou.personal.cr.aliyuncs.com/jockey/skywalking-oap-server-dragonwell
ENV SKYWALKING_UI_IMAGE_REPOSITORY crpi-wsxiy5y9ovijxdks.cn-hangzhou.personal.cr.aliyuncs.com/jockey/skywalking-ui-dragonwell
ENV SKYWALKING_IMAGE_TAG 10.4.0-dragonwell21
ENV SKYWALKING_IMAGE_PULL_POLICY IfNotPresent
ENV SKYWALKING_UI_OAP_ADDRESS http://skywalking-oap:12800
ENV SKYWALKING_UI_ZIPKIN_ADDRESS http://skywalking-oap:9412
ENV SKYWALKING_STORAGE_TYPE banyandb
ENV SKYWALKING_BANYANDB_TARGETS skywalking-banyandb:17912
ENV SKYWALKING_BANYANDB_ENABLED true
ENV SKYWALKING_BANYANDB_IMAGE_REPOSITORY apache/skywalking-banyandb
ENV SKYWALKING_BANYANDB_IMAGE_TAG 0.10.1
ENV SKYWALKING_BANYANDB_STORAGE_CLASS openebs-hostpath
ENV SKYWALKING_BANYANDB_STORAGE_SIZE 20Gi
ENV SKYWALKING_OAP_REQUESTS_CPU 500m
ENV SKYWALKING_OAP_LIMITS_CPU 2
ENV SKYWALKING_OAP_REQUESTS_MEMORY 1Gi
ENV SKYWALKING_OAP_LIMITS_MEMORY 2Gi
ENV SKYWALKING_UI_REQUESTS_CPU 100m
ENV SKYWALKING_UI_LIMITS_CPU 500m
ENV SKYWALKING_UI_REQUESTS_MEMORY 256Mi
ENV SKYWALKING_UI_LIMITS_MEMORY 1Gi
ENV SKYWALKING_BANYANDB_REQUESTS_CPU 500m
ENV SKYWALKING_BANYANDB_LIMITS_CPU 2
ENV SKYWALKING_BANYANDB_REQUESTS_MEMORY 1Gi
ENV SKYWALKING_BANYANDB_LIMITS_MEMORY 4Gi
ENV SEALOS_HOST_PREFIX skywalking
ENV SEALOS_CLOUD_DOMAIN 127.0.0.1.nip.io
ENV SEALOS_CERT_SECRET_NAME wildcard-cert
ENV SEALOS_INGRESS_CLASS_NAME nginx
ENV SEALOS_APP_ENABLED true

COPY charts charts
COPY registry registry

CMD ["helm upgrade --install skywalking charts/skywalking --namespace=$(NAMESPACE) --create-namespace --set skywalking.oap.replicas=$(SKYWALKING_OAP_REPLICAS) --set skywalking.ui.replicas=$(SKYWALKING_UI_REPLICAS) --set-string skywalking.oap.image.repository=$(SKYWALKING_OAP_IMAGE_REPOSITORY) --set-string skywalking.ui.image.repository=$(SKYWALKING_UI_IMAGE_REPOSITORY) --set-string skywalking.oap.image.tag=$(SKYWALKING_IMAGE_TAG) --set-string skywalking.ui.image.tag=$(SKYWALKING_IMAGE_TAG) --set-string skywalking.oap.image.pullPolicy=$(SKYWALKING_IMAGE_PULL_POLICY) --set-string skywalking.ui.image.pullPolicy=$(SKYWALKING_IMAGE_PULL_POLICY) --set-string skywalking.ui.oapAddress=$(SKYWALKING_UI_OAP_ADDRESS) --set-string skywalking.ui.zipkinAddress=$(SKYWALKING_UI_ZIPKIN_ADDRESS) --set-string skywalking.oap.storage.type=$(SKYWALKING_STORAGE_TYPE) --set-string skywalking.oap.storage.banyandbTargets=$(SKYWALKING_BANYANDB_TARGETS) --set skywalking.banyandb.enabled=$(SKYWALKING_BANYANDB_ENABLED) --set-string skywalking.banyandb.image.repository=$(SKYWALKING_BANYANDB_IMAGE_REPOSITORY) --set-string skywalking.banyandb.image.tag=$(SKYWALKING_BANYANDB_IMAGE_TAG) --set-string skywalking.banyandb.image.pullPolicy=$(SKYWALKING_IMAGE_PULL_POLICY) --set-string skywalking.banyandb.persistence.storageClass=$(SKYWALKING_BANYANDB_STORAGE_CLASS) --set-string skywalking.banyandb.persistence.size=$(SKYWALKING_BANYANDB_STORAGE_SIZE) --set-string skywalking.oap.requests.cpu=$(SKYWALKING_OAP_REQUESTS_CPU) --set-string skywalking.oap.limits.cpu=$(SKYWALKING_OAP_LIMITS_CPU) --set-string skywalking.oap.requests.memory=$(SKYWALKING_OAP_REQUESTS_MEMORY) --set-string skywalking.oap.limits.memory=$(SKYWALKING_OAP_LIMITS_MEMORY) --set-string skywalking.ui.requests.cpu=$(SKYWALKING_UI_REQUESTS_CPU) --set-string skywalking.ui.limits.cpu=$(SKYWALKING_UI_LIMITS_CPU) --set-string skywalking.ui.requests.memory=$(SKYWALKING_UI_REQUESTS_MEMORY) --set-string skywalking.ui.limits.memory=$(SKYWALKING_UI_LIMITS_MEMORY) --set-string skywalking.banyandb.requests.cpu=$(SKYWALKING_BANYANDB_REQUESTS_CPU) --set-string skywalking.banyandb.limits.cpu=$(SKYWALKING_BANYANDB_LIMITS_CPU) --set-string skywalking.banyandb.requests.memory=$(SKYWALKING_BANYANDB_REQUESTS_MEMORY) --set-string skywalking.banyandb.limits.memory=$(SKYWALKING_BANYANDB_LIMITS_MEMORY) --set-string sealos.hostPrefix=$(SEALOS_HOST_PREFIX) --set-string sealos.cloudDomain=$(SEALOS_CLOUD_DOMAIN) --set-string sealos.certSecretName=$(SEALOS_CERT_SECRET_NAME) --set-string sealos.ingressClassName=$(SEALOS_INGRESS_CLASS_NAME) --set sealos.app.enabled=$(SEALOS_APP_ENABLED)"]
