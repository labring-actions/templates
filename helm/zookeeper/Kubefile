FROM scratch

ENV NAMESPACE ns-admin
ENV ZOOKEEPER_REPLICAS 3
ENV ZOOKEEPER_IMAGE_REPOSITORY crpi-wsxiy5y9ovijxdks.cn-hangzhou.personal.cr.aliyuncs.com/jockey/sealos
ENV ZOOKEEPER_IMAGE_TAG zookeeper-3.7.2
ENV ZOOKEEPER_IMAGE_PULL_POLICY IfNotPresent
ENV ZOOKEEPER_STORAGE_CLASS openebs-hostpath
ENV ZOOKEEPER_STORAGE_SIZE 5Gi
ENV ZOOKEEPER_REQUESTS_CPU 250m
ENV ZOOKEEPER_LIMITS_CPU 1
ENV ZOOKEEPER_REQUESTS_MEMORY 512Mi
ENV ZOOKEEPER_LIMITS_MEMORY 1Gi
ENV ZOOKEEPER_HEAP_MIN 256m
ENV ZOOKEEPER_HEAP_MAX 512m
ENV ZOOKEEPER_TICK_TIME 2000
ENV ZOOKEEPER_INIT_LIMIT 10
ENV ZOOKEEPER_SYNC_LIMIT 5
ENV ZOOKEEPER_MAX_CLIENT_CNXNS 60
ENV ZOOKEEPER_4LW_COMMANDS_WHITELIST ruok,srvr,mntr,conf
ENV ZOOKEEPER_QUORUM_LISTEN_ON_ALL_IPS true
ENV ZOOKEEPER_AUTOPURGE_SNAP_RETAIN_COUNT 3
ENV ZOOKEEPER_AUTOPURGE_PURGE_INTERVAL 1
ENV ZOOKEEPER_ADMIN_SERVER_ENABLED true
ENV SEALOS_HOST_PREFIX zookeeper
ENV SEALOS_CLOUD_DOMAIN 127.0.0.1.nip.io
ENV SEALOS_CERT_SECRET_NAME wildcard-cert
ENV SEALOS_INGRESS_CLASS_NAME nginx
ENV SEALOS_INGRESS_ENABLED false
ENV SEALOS_APP_ENABLED false

COPY charts charts
COPY registry registry

CMD ["helm upgrade --install zookeeper charts/zookeeper --namespace=$(NAMESPACE) --create-namespace --set zookeeper.replicas=$(ZOOKEEPER_REPLICAS) --set-string zookeeper.image.repository=$(ZOOKEEPER_IMAGE_REPOSITORY) --set-string zookeeper.image.tag=$(ZOOKEEPER_IMAGE_TAG) --set-string zookeeper.image.pullPolicy=$(ZOOKEEPER_IMAGE_PULL_POLICY) --set-string zookeeper.persistence.storageClass=$(ZOOKEEPER_STORAGE_CLASS) --set-string zookeeper.persistence.size=$(ZOOKEEPER_STORAGE_SIZE) --set-string zookeeper.resources.requests.cpu=$(ZOOKEEPER_REQUESTS_CPU) --set-string zookeeper.resources.limits.cpu=$(ZOOKEEPER_LIMITS_CPU) --set-string zookeeper.resources.requests.memory=$(ZOOKEEPER_REQUESTS_MEMORY) --set-string zookeeper.resources.limits.memory=$(ZOOKEEPER_LIMITS_MEMORY) --set-string zookeeper.jvm.minHeap=$(ZOOKEEPER_HEAP_MIN) --set-string zookeeper.jvm.maxHeap=$(ZOOKEEPER_HEAP_MAX) --set zookeeper.config.tickTime=$(ZOOKEEPER_TICK_TIME) --set zookeeper.config.initLimit=$(ZOOKEEPER_INIT_LIMIT) --set zookeeper.config.syncLimit=$(ZOOKEEPER_SYNC_LIMIT) --set zookeeper.config.maxClientCnxns=$(ZOOKEEPER_MAX_CLIENT_CNXNS) --set-literal zookeeper.config.fourLetterWordsWhitelist=$(ZOOKEEPER_4LW_COMMANDS_WHITELIST) --set zookeeper.config.quorumListenOnAllIPs=$(ZOOKEEPER_QUORUM_LISTEN_ON_ALL_IPS) --set zookeeper.config.autopurgeSnapRetainCount=$(ZOOKEEPER_AUTOPURGE_SNAP_RETAIN_COUNT) --set zookeeper.config.autopurgePurgeInterval=$(ZOOKEEPER_AUTOPURGE_PURGE_INTERVAL) --set zookeeper.config.adminServerEnabled=$(ZOOKEEPER_ADMIN_SERVER_ENABLED) --set-string sealos.hostPrefix=$(SEALOS_HOST_PREFIX) --set-string sealos.cloudDomain=$(SEALOS_CLOUD_DOMAIN) --set-string sealos.certSecretName=$(SEALOS_CERT_SECRET_NAME) --set-string sealos.ingressClassName=$(SEALOS_INGRESS_CLASS_NAME) --set sealos.ingress.enabled=$(SEALOS_INGRESS_ENABLED) --set sealos.app.enabled=$(SEALOS_APP_ENABLED)"]
