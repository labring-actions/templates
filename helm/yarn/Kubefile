FROM scratch

ENV NAMESPACE ns-admin
ENV YARN_IMAGE_REPOSITORY crpi-wsxiy5y9ovijxdks.cn-hangzhou.personal.cr.aliyuncs.com/jockey/sealos
ENV YARN_IMAGE_TAG yarn-3.3.6
ENV YARN_IMAGE_PULL_POLICY IfNotPresent
ENV YARN_RESOURCEMANAGER_REPLICAS 1
ENV YARN_NODEMANAGER_REPLICAS 1
ENV YARN_FS_DEFAULT_URI file:///
ENV YARN_RM_STORAGE_CLASS openebs-hostpath
ENV YARN_RM_STORAGE_SIZE 5Gi
ENV YARN_NM_STORAGE_CLASS openebs-hostpath
ENV YARN_NM_STORAGE_SIZE 20Gi
ENV YARN_RM_REQUESTS_CPU 500m
ENV YARN_RM_LIMITS_CPU 2
ENV YARN_RM_REQUESTS_MEMORY 1Gi
ENV YARN_RM_LIMITS_MEMORY 2Gi
ENV YARN_NM_REQUESTS_CPU 500m
ENV YARN_NM_LIMITS_CPU 2
ENV YARN_NM_REQUESTS_MEMORY 2Gi
ENV YARN_NM_LIMITS_MEMORY 4Gi
ENV YARN_NODEMANAGER_MEMORY_MB 4096
ENV YARN_NODEMANAGER_VCORES 2
ENV YARN_SCHEDULER_MINIMUM_ALLOCATION_MB 128
ENV YARN_SCHEDULER_MAXIMUM_ALLOCATION_MB 4096
ENV YARN_LOG_AGGREGATION_ENABLED false
ENV SEALOS_CLOUD_DOMAIN 127.0.0.1.nip.io
ENV SEALOS_CERT_SECRET_NAME wildcard-cert
ENV SEALOS_INGRESS_CLASS_NAME nginx
ENV SEALOS_INGRESS_ENABLED true
ENV SEALOS_APP_ENABLED true
ENV SEALOS_HOST_PREFIX yarn

COPY charts charts
COPY registry registry

CMD ["helm upgrade --install yarn charts/yarn --namespace=$(NAMESPACE) --create-namespace --set-string yarn.image.repository=$(YARN_IMAGE_REPOSITORY) --set-string yarn.image.tag=$(YARN_IMAGE_TAG) --set-string yarn.image.pullPolicy=$(YARN_IMAGE_PULL_POLICY) --set yarn.resourceManager.replicas=$(YARN_RESOURCEMANAGER_REPLICAS) --set yarn.nodeManager.replicas=$(YARN_NODEMANAGER_REPLICAS) --set-string yarn.config.fsDefaultUri=$(YARN_FS_DEFAULT_URI) --set-string yarn.resourceManager.persistence.storageClass=$(YARN_RM_STORAGE_CLASS) --set-string yarn.resourceManager.persistence.size=$(YARN_RM_STORAGE_SIZE) --set-string yarn.nodeManager.persistence.storageClass=$(YARN_NM_STORAGE_CLASS) --set-string yarn.nodeManager.persistence.size=$(YARN_NM_STORAGE_SIZE) --set-string yarn.resourceManager.requests.cpu=$(YARN_RM_REQUESTS_CPU) --set-string yarn.resourceManager.limits.cpu=$(YARN_RM_LIMITS_CPU) --set-string yarn.resourceManager.requests.memory=$(YARN_RM_REQUESTS_MEMORY) --set-string yarn.resourceManager.limits.memory=$(YARN_RM_LIMITS_MEMORY) --set-string yarn.nodeManager.requests.cpu=$(YARN_NM_REQUESTS_CPU) --set-string yarn.nodeManager.limits.cpu=$(YARN_NM_LIMITS_CPU) --set-string yarn.nodeManager.requests.memory=$(YARN_NM_REQUESTS_MEMORY) --set-string yarn.nodeManager.limits.memory=$(YARN_NM_LIMITS_MEMORY) --set yarn.config.nodeManagerMemoryMb=$(YARN_NODEMANAGER_MEMORY_MB) --set yarn.config.nodeManagerVCores=$(YARN_NODEMANAGER_VCORES) --set yarn.config.schedulerMinimumAllocationMb=$(YARN_SCHEDULER_MINIMUM_ALLOCATION_MB) --set yarn.config.schedulerMaximumAllocationMb=$(YARN_SCHEDULER_MAXIMUM_ALLOCATION_MB) --set yarn.config.logAggregationEnabled=$(YARN_LOG_AGGREGATION_ENABLED) --set-string sealos.cloudDomain=$(SEALOS_CLOUD_DOMAIN) --set-string sealos.certSecretName=$(SEALOS_CERT_SECRET_NAME) --set-string sealos.ingressClassName=$(SEALOS_INGRESS_CLASS_NAME) --set sealos.ingress.enabled=$(SEALOS_INGRESS_ENABLED) --set sealos.app.enabled=$(SEALOS_APP_ENABLED) --set-string sealos.hostPrefix=$(SEALOS_HOST_PREFIX)"]
